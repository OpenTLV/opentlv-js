{
  "name": "opentlv-js",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Experimental OpenTLV JavaScript facade and WebAssembly bridge",
  "license": "MIT",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": { "import": "./index.mjs" },
    "./opentlv.mjs": { "import": "./dist/opentlv.mjs" },
    "./query.mjs": { "import": "./dist/query.mjs" },

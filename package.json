  "engines": { "node": "22.x" },
  "repository": { "type": "git", "url": "https://github.com/OpenTLV/opentlv-js.git" },
  "bugs": { "url": "https://github.com/OpenTLV/opentlv-js/issues" },
  "homepage": "https://github.com/OpenTLV/opentlv-js#readme"

{
  "name": "@opentlv/opentlv",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental OpenTLV JavaScript facade and WebAssembly bridge",
  "license": "MIT",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs"
    },
    "./opentlv.mjs": {
      "types": "./dist/opentlv.d.mts",
      "import": "./dist/opentlv.mjs"
    },
    "./query.mjs": {
      "types": "./dist/query.d.mts",
      "import": "./dist/query.mjs"
    },
    "./opentlv-core.js": {
      "types": "./opentlv-core.d.mts",
      "import": "./dist/opentlv-core.js"
    },
    "./opentlv-core.wasm": "./dist/opentlv-core.wasm",
    "./version": {
      "types": "./version.d.mts",
      "import": "./version.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "version.mjs",
    "dist/opentlv.mjs",
    "dist/query.mjs",
    "dist/opentlv-core.js",
    "dist/opentlv-core.wasm",
    "package-info.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "index.d.mts",
    "version.d.mts",
    "opentlv-core.d.mts",
    "dist/opentlv.d.mts",
    "dist/query.d.mts",
    "LICENSES/MIT.txt",
    "THIRD_PARTY.md",
    "notices/core-LICENSE.txt",
    "notices/emscripten-LICENSE.txt",
    "notices/musl-COPYRIGHT.txt",
    "notices/compiler-rt-LICENSE.txt"
  ],
  "engines": {
    "node": "22.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenTLV/opentlv-js.git"
  },
  "bugs": {
    "url": "https://github.com/OpenTLV/opentlv-js/issues"
  },
  "homepage": "https://github.com/OpenTLV/opentlv-js#readme",
  "types": "./index.d.mts"
}

    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "version.mjs",
    "dist/opentlv.mjs",
    "dist/query.mjs",
    "dist/opentlv-core.js",
    "dist/opentlv-core.wasm",
    "package-info.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
